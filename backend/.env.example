# Base de datos (local Docker / producción gestionada). En producción solo cambiás estas credenciales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=conciertos
DB_USER=conciertos
DB_PASSWORD=conciertos_dev
# Modo SSL para la conexión (requerido por Supabase/Neon/Render: require). Vacío = sin forzar.
DB_SSLMODE=

# Servidor
PORT=5000
HOST=0.0.0.0

# Scraper automático en minutos (1440 = cada 24 h). 0 = desactivado.
# En producción (imagen Docker de Render) el intervalo que manda es render.yaml: 1440.
SCRAPER_INTERVALO_MINUTOS=1440

# URL para keep_alive (en producción: https://tu-backend.onrender.com). Vacío = desactivado.
KEEP_ALIVE_URL=

# Secreto para firmar los JWT del login. ¡Obligatorio cambiarlo en producción!
# En producción (DB_SSLMODE activo) el arranque falla si no está definido.
JWT_SECRET=

# Orígenes permitidos de CORS, separados por coma (sin espacios). Vacío en dev
# permite localhost. En producción definir los dominios reales del frontend.
# Ejemplo: CORS_ORIGINS=https://bassonicos.onrender.com,https://www.tudominio.com
CORS_ORIGINS=

# Notificaciones push (Web Push con VAPID). Generar con: go run ./cmd/generar_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@bassonicos.com

# URL pública del frontend (para enlaces en push e .ics)
SITIO_WEB=http://localhost

# Script de Python del scraper (scripts que siguen siendo Python).
PYTHON_CMD=python
SCRAPER_PATH=../scraper/scraper.py
SCRAPER_RUN_DIR=.